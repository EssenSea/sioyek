#!/bin/sh
# =============================================================================
# configure -- autoconf-style configuration front-end for the CMake build.
#
# Records the chosen options and a default preset into ./config.mk, which the
# top-level Makefile includes. Afterwards, plain `make` (and the per-preset
# targets such as `make linux-portable`) use those options.
#
# Usage:
#   ./configure --enable-lto --disable-tests --with-system-mupdf
#   ./configure --with-install-layout=portable --preset=linux-portable
#   ./configure --help
#
# Recognized options (see `make options` for the full table):
#   --enable-X / --with-X              -> -DSIOYEK_*=ON    (any prefix works)
#   --disable-X / --without-X          -> -DSIOYEK_*=OFF
#   --enable-X=VALUE / --with-X=VALUE  -> -DSIOYEK_*=VALUE  (yes/on/1 -> ON,
#                                                            no/off/0 -> OFF)
#   raw -D...                          -> passed through
#   --preset=<name>                    -> default PRESET for make
#
# Re-running ./configure replaces the recorded options; --wipe removes config.mk.
# =============================================================================
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
parser="$repo_root/cmake/parse-build-options.sh"
config_mk="$repo_root/config.mk"

usage() {
	cat <<EOF
Usage: ./configure [OPTIONS]

Autoconf-style front-end for sioyek's CMake build. Options are recorded in
config.mk and used by subsequent \`make\` invocations.

Installation directories (GNUInstallDirs):
EOF
	while IFS=: read -r name var; do
		printf '  --%-24s %s\n' "${name}=DIR" "$var"
	done <<DIRS
$("$repo_root/cmake/parse-build-options.sh" --list-dirs)
DIRS
	cat <<EOF

Features (translated to -DSIOYEK_* CMake variables). Any of the four prefixes
works for every option (autoconf convention: --with-X == --enable-X,
--without-X == --disable-X):
  --enable-X / --with-X               enable a feature (or =VALUE)
  --disable-X / --without-X           disable a feature
  --enable-X=VALUE                    set an explicit value (yes/on/1 -> ON,
                                      no/off/0 -> OFF, else verbatim)
EOF
	while IFS=: read -r name var; do
		printf '  %-38s %s\n' "--enable-${name} / --with-${name}" "$var"
	done <<OPTS
$("$repo_root/cmake/parse-build-options.sh" --list)
OPTS
	cat <<EOF

Other:
  --preset=NAME                       default preset for \`make\` (e.g. linux-vendored)
  -D<var>=<value>                     raw CMake flag (passed through)
  --help                              show this help
  --wipe                              remove config.mk (reset to defaults)

Examples:
  ./configure --prefix=/usr --sysconfdir=/etc
  ./configure --enable-lto --disable-tests
  ./configure --with-system-mupdf --with-install-layout=portable --preset=linux-portable
EOF
}

preset=""
want_wipe=0
passthru=""
for a in "$@"; do
case "$a" in
--help|-h) usage; exit 0 ;;
--wipe) want_wipe=1 ;;
--preset=*) preset=${a#--preset=} ;;
*) passthru="$passthru $a" ;;
esac
done

if [ "$want_wipe" = 1 ]; then
rm -f "$config_mk"
echo "configure: removed config.mk (defaults restored)"
exit 0
fi

# Translate the friendly options (empty when none were given).
flags=""
if [ -n "${passthru# }" ]; then
# shellcheck disable=SC2086
flags=$("$parser" $passthru) || exit $?
fi

# Validate an explicit preset, if any.
#
# The validation list is produced by cmake/list-build-presets.cmake (a CMake
# script) rather than by \`cmake --list-presets | grep\`, so this works without
# \`grep\` and agrees exactly with the preset list the Makefile derives its
# shortcut targets from -- one source of truth for both.
#
# A MISSING cmake is now a hard error rather than a silent skip. The previous
# implementation wrapped the whole check in \`if command -v cmake\`, so on a host
# without cmake ./configure accepted ANY --preset value, wrote it into config.mk,
# and the failure surfaced much later as a confusing make error. Refusing early
# is consistent with the Makefile, which already fails hard when cmake is absent.
if [ -n "$preset" ]; then
if ! command -v cmake >/dev/null 2>&1; then
echo "configure: cmake is required to validate --preset=$preset, but it was not found in PATH" >&2
exit 2
fi
if [ -f "$repo_root/CMakePresets.json" ]; then
if ! cmake -D "SIOYEK_PRESETS_FILE=$repo_root/CMakePresets.json" \
        -P "$repo_root/cmake/list-build-presets.cmake" 2>/dev/null | grep -qx "$preset"; then
echo "configure: unknown preset '$preset'" >&2
echo "configure: available presets:" >&2
cmake -D "SIOYEK_PRESETS_FILE=$repo_root/CMakePresets.json" \
    -P "$repo_root/cmake/list-build-presets.cmake" 2>/dev/null | sed 's/^/  /' >&2
exit 2
fi
fi
fi

# Write config.mk (always, so re-running ./configure is idempotent).
{
echo "# Generated by ./configure -- do not edit (git-ignored)."
echo "# Re-run ./configure (or ./configure --wipe) to change."
echo "SIOYEK_CONFIGURE_FLAGS := $flags"
if [ -n "$preset" ]; then
echo "PRESET := $preset"
fi
} > "$config_mk"

echo "configure: wrote config.mk"
[ -n "$flags" ] && echo "  flags:${flags}"
[ -n "$preset" ] && echo "  preset: $preset"
echo "configure: now run 'make' (or 'make <preset>', e.g. 'make linux-portable')"
