#!/bin/sh
# =============================================================================
# configure -- autoconf-style configuration front-end for the CMake build.
#
# Records the chosen options and a default preset into ./config.mk, which the
# top-level Makefile includes. Afterwards, plain `make` (and the per-preset
# targets such as `make linux-portable`) use those options.
#
# Usage:
#   ./configure --enable-lto --disable-tests --with-system-mupdf
#   ./configure --with-install-layout=portable --preset=linux-portable
#   ./configure --help
#
# Recognized options (see `make options` for the full table):
#   --enable-X / --with-X              -> -DSIOYEK_*=ON    (any prefix works)
#   --disable-X / --without-X          -> -DSIOYEK_*=OFF
#   --enable-X=VALUE / --with-X=VALUE  -> -DSIOYEK_*=VALUE  (yes/on/1 -> ON,
#                                                            no/off/0 -> OFF)
#   raw -D...                          -> passed through
#   --preset=<name>                    -> default PRESET for make
#
# Re-running ./configure replaces the recorded options; --wipe removes config.mk.
# =============================================================================
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
parser="$repo_root/cmake/parse-build-options.sh"
config_mk="$repo_root/config.mk"

usage() {
cat <<EOF
Usage: ./configure [OPTIONS]

Autoconf-style front-end for sioyek's CMake build. Options are recorded in
config.mk and used by subsequent \`make\` invocations.

Configuration options (translated to -DSIOYEK_* CMake variables).
Any of the four prefixes works for any option (autoconf convention:
--with-X == --enable-X, --without-X == --disable-X):
  --enable-X / --with-X               enable a feature (or =VALUE)
  --disable-X / --without-X           disable a feature
  --enable-X=VALUE                    set an explicit value (yes/on/1 -> ON,
                                      no/off/0 -> OFF, else verbatim)
  -D<var>=<value>                     raw CMake flag (passed through)

See all options with \`make options\`.

Build selection:
  --preset=NAME                       default preset for \`make\` (e.g. linux-vendored)
  --help                              show this help
  --wipe                              remove config.mk (reset to defaults)

Examples:
  ./configure --enable-lto --disable-tests
  ./configure --with-system-mupdf --with-install-layout=portable --preset=linux-portable
  ./configure -DSIOYEK_ENABLE_LTO=OFF
EOF
}

preset=""
want_wipe=0
passthru=""
for a in "$@"; do
case "$a" in
--help|-h) usage; exit 0 ;;
--wipe) want_wipe=1 ;;
--preset=*) preset=${a#--preset=} ;;
*) passthru="$passthru $a" ;;
esac
done

if [ "$want_wipe" = 1 ]; then
rm -f "$config_mk"
echo "configure: removed config.mk (defaults restored)"
exit 0
fi

# Translate the friendly options (empty when none were given).
flags=""
if [ -n "${passthru# }" ]; then
# shellcheck disable=SC2086
flags=$("$parser" $passthru) || exit $?
fi

# Validate an explicit preset, if any.
if [ -n "$preset" ]; then
if command -v cmake >/dev/null 2>&1; then
if ! (cd "$repo_root" && cmake --list-presets 2>/dev/null | grep -q "\"$preset\""); then
echo "configure: unknown preset '$preset' (run 'cmake --list-presets')" >&2
exit 2
fi
fi
fi

# Write config.mk (always, so re-running ./configure is idempotent).
{
echo "# Generated by ./configure -- do not edit (git-ignored)."
echo "# Re-run ./configure (or ./configure --wipe) to change."
echo "SIOYEK_CONFIGURE_FLAGS := $flags"
if [ -n "$preset" ]; then
echo "PRESET := $preset"
fi
} > "$config_mk"

echo "configure: wrote config.mk"
[ -n "$flags" ] && echo "  flags:${flags}"
[ -n "$preset" ] && echo "  preset: $preset"
echo "configure: now run 'make' (or 'make <preset>', e.g. 'make linux-portable')"
